{
  "id": "donchian-breakout-h4",
  "version": "1.0.0",
  "type": "SWING",
  "timeframes": {
    "signal_tf": "H4",
    "entry_tf": "H4"
  },
  "instruments": {
    "allowed_classes": [
      "FX"
    ],
    "allowed_symbols": [
      "EURUSD",
      "GBPUSD"
    ],
    "denied_symbols": []
  },
  "entries": [
    {
      "direction": "LONG",
      "trigger": {
        "type": "all_of",
        "conditions": [
          {
            "type": "leaf",
            "op": "cross_above",
            "left": "price:close",
            "right": {
              "indicator": "donchian",
              "params": {
                "period": 20
              },
              "channel": "upper",
              "shift": 1
            }
          },
          {
            "type": "leaf",
            "op": "gt",
            "left": {
              "indicator": "macd",
              "channel": "macd"
            },
            "right": 0.0
          }
        ]
      },
      "confirmation": [],
      "invalidation": {
        "price_level": {
          "indicator": "donchian",
          "params": {
            "period": 10
          },
          "channel": "lower",
          "shift": 1
        }
      },
      "entry_order": {
        "order": {
          "type": "MARKET"
        },
        "expire_after_bars": 1
      }
    },
    {
      "direction": "SHORT",
      "trigger": {
        "type": "all_of",
        "conditions": [
          {
            "type": "leaf",
            "op": "cross_below",
            "left": "price:close",
            "right": {
              "indicator": "donchian",
              "params": {
                "period": 20
              },
              "channel": "lower",
              "shift": 1
            }
          },
          {
            "type": "leaf",
            "op": "lt",
            "left": {
              "indicator": "macd",
              "channel": "macd"
            },
            "right": 0.0
          }
        ]
      },
      "confirmation": [],
      "invalidation": {
        "price_level": {
          "indicator": "donchian",
          "params": {
            "period": 10
          },
          "channel": "upper",
          "shift": 1
        }
      },
      "entry_order": {
        "order": {
          "type": "MARKET"
        },
        "expire_after_bars": 1
      }
    }
  ],
  "exit_ref": "structure_trail",
  "filters": [
    {
      "kind": "spread_max",
      "max_spread_pips": 2.0
    }
  ],
  "risk_profile": {
    "base_quality": 0.5,
    "quality_modifiers": [
      {
        "condition": {
          "type": "leaf",
          "op": "gt",
          "left": {
            "indicator": "adx",
            "params": {
              "period": 14
            },
            "channel": "adx"
          },
          "right": 25.0
        },
        "delta": 0.15,
        "reason": "A channel break with ADX above 25 is a break out of a market already moving"
      }
    ],
    "stop_reference": {
      "kind": "ATR",
      "period": 20,
      "multiple": 2.0
    },
    "max_concurrent_positions": 1,
    "cooldown_bars_after_loss": 0
  }
}
