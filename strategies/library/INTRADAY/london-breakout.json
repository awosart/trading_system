{
  "id": "london-breakout",
  "version": "2.0.0",
  "type": "INTRADAY",
  "timeframes": {
    "signal_tf": "M15",
    "entry_tf": "M5"
  },
  "instruments": {
    "allowed_classes": [
      "FX"
    ],
    "allowed_symbols": [
      "EURUSD",
      "GBPUSD"
    ],
    "denied_symbols": []
  },
  "market_regimes": [],
  "entries": [
    {
      "direction": "LONG",
      "trigger": {
        "type": "leaf",
        "op": "cross_above",
        "left": "price:close",
        "right": {
          "indicator": "donchian",
          "params": {
            "period": 20
          },
          "channel": "upper"
        }
      },
      "confirmation": [],
      "confirmation_window_bars": 0,
      "invalidation": {
        "price_level": {
          "indicator": "donchian",
          "params": {
            "period": 20
          },
          "channel": "middle"
        }
      },
      "entry_order": {
        "order": {
          "type": "STOP",
          "offset": 0.0002
        },
        "expire_after_bars": 4
      }
    },
    {
      "direction": "SHORT",
      "trigger": {
        "type": "leaf",
        "op": "cross_below",
        "left": "price:close",
        "right": {
          "indicator": "donchian",
          "params": {
            "period": 20
          },
          "channel": "lower"
        }
      },
      "confirmation": [],
      "confirmation_window_bars": 0,
      "invalidation": {
        "price_level": {
          "indicator": "donchian",
          "params": {
            "period": 20
          },
          "channel": "middle"
        }
      },
      "entry_order": {
        "order": {
          "type": "STOP",
          "offset": 0.0002
        },
        "expire_after_bars": 4
      }
    }
  ],
  "exit_ref": "atr_trail_aggressive",
  "filters": [
    {
      "kind": "session",
      "sessions": [
        "LONDON"
      ]
    },
    {
      "kind": "time_of_day",
      "start": "07:00",
      "end": "09:00"
    },
    {
      "kind": "news_blackout",
      "minutes_before": 30,
      "minutes_after": 30,
      "min_impact": "HIGH"
    },
    {
      "kind": "spread_max",
      "max_spread_pips": 2.0
    }
  ],
  "risk_profile": {
    "base_quality": 0.5,
    "quality_modifiers": [
      {
        "condition": {
          "type": "leaf",
          "op": "gt",
          "left": {
            "indicator": "atr",
            "params": {
              "period": 14
            }
          },
          "right": 0.0006
        },
        "delta": 0.1,
        "reason": "Sufficient volatility for a breakout to run rather than stall"
      },
      {
        "condition": {
          "type": "leaf",
          "op": "session_is",
          "right": {
            "labels": [
              "LONDON_NY_OVERLAP"
            ]
          }
        },
        "delta": 0.05,
        "reason": "The overlap is the deepest book of the day, so a break is likelier to follow through"
      }
    ],
    "stop_reference": {
      "kind": "FIXED_PIPS",
      "pips": 15.0
    },
    "max_concurrent_positions": 1,
    "cooldown_bars_after_loss": 8
  }
}
