        "conditions": [
          {
            "type": "leaf",
            "op": "lt",
            "left": {
              "indicator": "rsi",
              "params": {
                "period": 14
              }
            },
            "right": 30.0
          },
          {
            "type": "leaf",
            "op": "lt",
            "left": {
              "indicator": "adx",
              "params": {
                "period": 14
              },
              "channel": "adx"
            },
            "right": 20.0
          }
        ]
      },
      "confirmation": [
        {
          "type": "leaf",
          "op": "gt",
          "left": {
            "indicator": "rsi",
            "params": {
              "period": 14
            }
          },
          "right": 30.0
        },
        {
          "type": "leaf",
          "op": "pattern_is",
          "right": {
            "labels": [
              "HAMMER",
              "BULLISH_ENGULFING",
              "MORNING_STAR"
            ]
          }
        }
      ],
      "confirmation_window_bars": 3,
      "invalidation": {
