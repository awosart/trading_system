{
  "id": "rsi-mean-reversion",
  "version": "1.0.0",
  "type": "INTRADAY",
  "timeframes": {
    "signal_tf": "M15",
    "htf_filter_tf": "H4",
    "entry_tf": "M15"
  },
  "instruments": {
