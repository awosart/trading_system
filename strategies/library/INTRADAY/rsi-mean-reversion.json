    {
      "kind": "spread_max",
      "max_spread_pips": 1.5
    },
    {
      "kind": "volatility_range",
      "feature": {
        "indicator": "atr",
        "params": {
          "period": 14
        }
      },
      "min_value": 0.0003,
      "max_value": 0.002
    }
  ],
  "risk_profile": {
    "base_quality": 0.5,
    "quality_modifiers": [
      {
        "condition": {
          "type": "leaf",
          "op": "lt",
          "left": {
            "indicator": "rsi",
            "params": {
              "period": 14
            }
          },
          "right": 20.0
